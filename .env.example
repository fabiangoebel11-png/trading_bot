# Binance USDT-M Futures API credentials (never commit the real .env file)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Set to "true" to route orders to the Binance Futures testnet
BINANCE_TESTNET=true

# Safety switch: live_trader.py refuses to send real orders unless this is "false"
DRY_RUN=true

# Required in addition to DRY_RUN=false before the testnet lifecycle harness
# is permitted to place and immediately clean up a test order.
TESTNET_ORDER_TEST=false
